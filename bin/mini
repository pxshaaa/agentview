#!/bin/sh
# agentview — watch and talk to headless Claude Code agents on a remote host.
: "${AGENT_HOST:?set AGENT_HOST to the ssh host your agents run on, e.g. export AGENT_HOST=myserver}"
# Interactive overview of the agent runs on $AGENT_HOST.
#   mini              the dashboard: ↑↓ move · ↵ open · ← back · m message · q quit
#   mini once         one plain snapshot (scripts, scrollback)
#   mini show <id>    that run's report + uncommitted diffstat, as plain text
case "${1:-}" in
  once|status) ssh "$AGENT_HOST" "~/bin/agentrun-tui --once" ;;
  all)         ssh "$AGENT_HOST" "~/bin/agentrun-tui --once --all" ;;
  show)
    ID="$2"; [ -z "$ID" ] && { echo "usage: mini show <id>"; exit 1; }
    ssh "$AGENT_HOST" "
      R=\$HOME/.agentrun/$ID
      T=\$(python3 -c \"
import json
from pathlib import Path
p=Path.home()/'.agentrun'/'$ID.json'
print(json.loads(p.read_text()).get('title','$ID') if p.exists() else '$ID')\")
      echo; echo \"=== \$T ===\"; echo
      if   [ -f \$R.report ];   then cat \$R.report
      elif [ -f /tmp/$ID.log ]; then cat /tmp/$ID.log
      else echo '(still running — open it in \`mini\` to watch live)'; fi
      W=\$(python3 -c \"
import json
from pathlib import Path
p=Path.home()/'.agentrun'/'$ID.json'
print(json.loads(p.read_text()).get('worktree','') if p.exists() else '')\")
      if [ -n \"\$W\" ] && [ -d \"\$W\" ]; then
        echo; echo '--- uncommitted in '\$W' ---'
        git -C \"\$W\" status --porcelain
        git -C \"\$W\" diff --stat | tail -25
      fi" ;;
  -h|--help)   sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//' ;;
  "")          ssh -t "$AGENT_HOST" "~/bin/agentrun-tui" ;;
  *)           echo "usage: mini [once|all|show <id>]"; exit 1 ;;
esac
