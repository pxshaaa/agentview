# Regenerate with:  vhs demo/demo.tape
# Records a real session against a sandbox registry, not live work.
Output demo/agentview.gif

Set Shell "bash"
Set FontSize 14
Set Width 1180
Set Height 720
Set Padding 22
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms
Set Framerate 12
Set PlaybackSpeed 1.0

Hide
Type "export AGENT_HOST=macmini AGENTRUN_DIR=/tmp/demoreg AGENTRUN_NO_ADOPT=1"
Enter
Type "export PATH=$HOME/Documents/agentview/bin:$PATH; clear"
Enter
Sleep 1s
Show

Type "mini"
Sleep 500ms
Enter
Sleep 5s

Down
Sleep 1500ms
Enter
Sleep 6s

Down
Sleep 800ms
Down
Sleep 3s

Left
Sleep 3s

Type "q"
Sleep 1500ms
