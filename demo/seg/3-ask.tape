Output demo/seg/3.gif
Set Shell "bash"
Set FontSize 19
Set Width 1180
Set Height 640
Set Padding 26
Set LineHeight 1.25
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms
Set Framerate 20

Hide
Type "export AGENT_HOST=macmini AGENTRUN_DIR=/tmp/demoreg AGENTRUN_NO_ADOPT=1"
Enter
Type "export PATH=$HOME/Documents/agentview/bin:$PATH; clear"
Enter
Sleep 1s
Type "mini"
Enter
Sleep 6s
Enter
Sleep 4s
Show

Sleep 1500ms
Type "m"
Sleep 2s
Type "anything risky before I commit?"
Sleep 1s
Enter
Sleep 22s
Hide
Type "q"
Sleep 500ms
