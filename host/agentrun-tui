#!/usr/bin/env python3
"""Interactive overview of the agent runs on this machine.

  ↑ ↓        move          ↵ or →   open a run
  ← or esc   back           m       message the agent
  a          show harvested runs    q  quit

Reads Claude's own session transcripts, so every run is visible whether or not
it was launched through mini-run. Never kills, commits or pushes; the only
writes are run metadata under ~/.agentrun and messages you deliberately send.
"""
import json, os, re, select, subprocess, sys, termios, threading, time, tty
from pathlib import Path

REG   = Path(os.environ.get("AGENTRUN_DIR") or (Path.home() / ".agentrun"))
PROJ  = Path.home() / ".claude" / "projects"
STALL = int(os.environ.get("AGENTRUN_STALL") or 600)

E = "\033["
# In --once mode the output is often piped; raw escapes there are noise.
_COLOR = not os.environ.get("NO_COLOR")
def sgr(s, c): return f"{E}{c}m{s}{E}0m" if _COLOR else s
dim    = lambda s: sgr(s, "2")
bold   = lambda s: sgr(s, "1")
green  = lambda s: sgr(s, "32")
yellow = lambda s: sgr(s, "33")
cyan   = lambda s: sgr(s, "36")
red    = lambda s: sgr(s, "31")
inv    = lambda s: sgr(s, "7")

def hms(sec):
    sec = int(sec or 0)
    if sec < 60:   return f"{sec}s"
    if sec < 3600: return f"{sec//60}m"
    return f"{sec//3600}h{(sec%3600)//60:02d}"

def visible_len(s): return len(re.sub(r"\033\[[0-9;]*m", "", s))

# ---------------------------------------------------------------- process ---
def ps_snapshot():
    out = {}
    try:
        r = subprocess.run(["ps", "-o", "pid=,args=", "-ax"],
                           capture_output=True, text=True, timeout=10)
        for line in r.stdout.splitlines():
            pid, _, args = line.strip().partition(" ")
            if pid.isdigit(): out[int(pid)] = args.strip()
    except Exception:
        pass
    return out

def alive(pid, rid, ps):
    """A PID alone is not proof — the OS reuses them. Require the run id too."""
    try: pid = int(pid)
    except (TypeError, ValueError): return False
    return rid in ps.get(pid, "")

def strays(ps, known):
    out = []
    for pid, args in ps.items():
        if "claude -p" not in args: continue
        if not args.startswith(("sh -c", "/bin/sh -c")): continue
        m = re.search(r"/tmp/([A-Za-z0-9_.-]+)\.brief", args)
        if m and m.group(1) in known: continue
        out.append((pid, m.group(1) if m else None, args))
    return out

# ------------------------------------------------------------- transcripts ---
_TFCACHE = {}

def transcript_for(worktree, started, rid=None):
    """Cached: the glob and stat of every session file is pure overhead once the
    match is known, and it ran for all 25 runs on every refresh."""
    key, now = (worktree, rid), time.time()
    hit = _TFCACHE.get(key)
    if hit:
        ts, val = hit
        if val is not False and val.exists():
            return val
        # A miss must expire. A run opened before its transcript file appeared
        # was cached as "no transcript" for the life of the process, which left
        # it showing 0 tool calls and refusing to be messaged.
        if val is False and now - ts < 10:
            return None
    val = _transcript_for(worktree, started, rid)
    if len(_TFCACHE) > 128: _TFCACHE.clear()
    _TFCACHE[key] = (now, val if val else False)
    return val

def _transcript_for(worktree, started, rid=None):
    """Claude writes a live transcript per session under ~/.claude/projects,
    regardless of the launcher's output format. Runs started by agentrun-launch
    also write our own stream, which is an exact match rather than a guess —
    prefer it, and fall back to the project transcript for everything else."""
    if rid:
        own = REG / f"{rid}.jsonl"
        if own.exists() and own.stat().st_size: return own
    if not worktree: return None
    # /tmp is a symlink to /private/tmp on macOS; the slug uses the real path.
    try: worktree = str(Path(worktree).resolve())
    except Exception: pass
    d = PROJ / worktree.replace("/", "-").replace(".", "-")
    if not d.is_dir(): return None
    best, best_gap = None, None
    for f in d.glob("*.jsonl"):
        try: st = f.stat()
        except OSError: continue
        if st.st_mtime < (started or 0) - 60: continue   # ended before we began
        gap = abs(st.st_ctime - (started or st.st_ctime))
        if best_gap is None or gap < best_gap:
            best, best_gap = f, gap
    return best

def session_id_in(path):
    """Our own stream carries the session id in its events rather than its name."""
    try:
        with path.open("r", errors="replace") as f:
            for _ in range(60):
                line = f.readline()
                if not line: break
                if '"session_id"' not in line: continue
                try: d = json.loads(line)
                except Exception: continue
                if d.get("session_id"): return d["session_id"]
    except Exception:
        pass
    return None

_TCACHE = {}

def read_transcript(path, tail_bytes=900_000):
    """Return (events, last_mtime). Only the tail is parsed — these reach MBs —
    and the result is cached until the file grows, because the overview would
    otherwise re-parse every transcript on every frame."""
    ev = []
    if not path or not path.exists(): return ev, None
    st = path.stat()
    key = (str(path), tail_bytes)
    hit = _TCACHE.get(key)
    if hit and hit[0] == (st.st_size, st.st_mtime):
        return hit[1], st.st_mtime
    size = st.st_size
    with path.open("rb") as f:
        if size > tail_bytes:
            f.seek(size - tail_bytes); f.readline()
        chunk = f.read().decode("utf-8", "replace")
    for line in chunk.splitlines():
        line = line.strip()
        if not line.startswith("{"): continue
        try: d = json.loads(line)
        except Exception: continue
        if d.get("type") != "assistant": continue
        ts = d.get("timestamp")
        for b in d.get("message", {}).get("content", []):
            if b.get("type") == "text" and b.get("text", "").strip():
                ev.append(("say", b["text"].rstrip(), ts))
            elif b.get("type") == "tool_use":
                inp = b.get("input") or {}
                tgt = (inp.get("file_path") or inp.get("path") or inp.get("pattern")
                       or inp.get("command") or inp.get("description") or "")
                tgt = " ".join(str(tgt).split())
                if len(tgt) > 70: tgt = tgt[:69] + "…"
                nm = b.get("name") or "?"
                ev.append(("tool", (nm, tgt, describe(nm, inp)), ts))
    if len(_TCACHE) > 64: _TCACHE.clear()
    _TCACHE[key] = ((st.st_size, st.st_mtime), ev)
    return ev, st.st_mtime

FENCE = re.compile(r"```.*?```", re.S)
LINKS = re.compile(r"\[([^\]]{1,60})\]\([^)]+\)")

def strip_md(text):
    """Agents write reports in markdown. On a terminal the syntax is noise, and
    a fenced diff or a table turns the panel into a wall. Keep the sentences."""
    t = FENCE.sub(" (code) ", str(text))
    out = []
    for ln in t.splitlines():
        st = ln.strip()
        if not st:
            out.append("")
            continue
        if st.startswith("|") or set(st) <= set("|-: "):
            if out and out[-1] == "(table)": continue
            out.append("(table)"); continue
        st = LINKS.sub(r"\1", st)
        h = re.match(r"^#{1,6}\s*(.+)$", st)
        if h:
            out.append("── " + h.group(1).replace("**", "").replace("`", ""))
            continue
        st = re.sub(r"^[-*+]\s+", "· ", st)
        st = st.replace("**", "").replace("__", "").replace("`", "")
        out.append(st)
    return [l for l in out]

def digest(paragraph, width, cap):
    """First `cap` wrapped lines of a block, plus how much was left."""
    flat = []
    for ln in strip_md(paragraph):
        flat += wrap(ln, width) if ln.strip() else [""]
    flat = [l for l in flat if l.strip()]
    return flat[:cap], max(0, len(flat) - cap)

def _base(x):
    x = str(x).strip().strip("\"'")
    return x.rsplit("/", 1)[-1] or x

def describe(name, inp):
    """Turn a tool call into something a person can skim. The raw command is
    noise; what matters is what the agent was trying to find out or change."""
    inp = inp or {}
    if name == "Read":   return "read " + _base(inp.get("file_path", ""))
    if name == "Write":  return "wrote " + _base(inp.get("file_path", ""))
    if name in ("Edit", "NotebookEdit"):
        return "edited " + _base(inp.get("file_path", ""))
    if name == "Grep":
        where = " in " + _base(inp.get("path")) if inp.get("path") else ""
        return "searched for " + str(inp.get("pattern", ""))[:40] + where
    if name == "Glob":      return "listed files matching " + str(inp.get("pattern", ""))
    if name == "TodoWrite": return "updated its plan"
    if name == "Task":      return "delegated a subtask"
    if name in ("WebFetch", "WebSearch"):
        return "looked up " + str(inp.get("url") or inp.get("query", ""))[:50]
    if name != "Bash":
        return name.lower()

    c = " ".join(str(inp.get("command", "")).split())
    low = c.lower()
    if re.search(r"\b(pytest|jest|go test|cargo test|npm test|-m unittest)\b", low):
        return "ran tests"
    if low.startswith("git diff"):   return "checked the diff"
    if low.startswith("git status"): return "checked git status"
    if low.startswith("git log"):    return "checked the history"
    if low.startswith("git show"):   return "read a committed version"
    if low.startswith(("grep", "rg ")) or "| grep" in low:
        m = re.search(r"(?:grep|rg)\s+(?:-\S+\s+)*[\"']?([^\"'|;>]{1,40})", c)
        return "searched for " + m.group(1).strip() if m else "searched the codebase"
    if low.startswith("sed -n"):
        m = re.search(r"sed -n\s+(\d+),(\d+)p\s+(\S+)", c)
        if m: return "read lines %s–%s of %s" % (m.group(1), m.group(2), _base(m.group(3)))
        return "read part of a file"
    if low.startswith(("cat ", "head ", "tail ")):
        # `cat > file <<EOF` writes a file; only `cat file` reads one.
        m = re.search(r"^\w+\s+(?:-\S+\s+)*([^\s>|]+)", c)
        if re.match(r"^\w+\s*>", c):
            w = re.search(r">\s*(\S+)", c)
            return "wrote " + _base(w.group(1)) if w else "wrote a file"
        return "read " + _base(m.group(1)) if m else "read a file"
    if low.startswith(("ls", "find ", "tree")):     return "listed files"
    if low.startswith(("python3", "python", "node ", "npx ")): return "ran a script"
    if low.startswith("docker"):                    return "ran a container"
    if low.startswith(("mkdir", "cp ", "mv ")):     return "moved files around"
    if low.startswith(("echo", "printf")):          return "wrote some text"
    return "ran " + _base((c.split() or ["?"])[0])

PHASE = {"Read": "reading", "Grep": "searching", "Glob": "searching",
         "Edit": "editing", "Write": "writing", "NotebookEdit": "editing",
         "Bash": "running", "Task": "delegating", "WebFetch": "fetching",
         "WebSearch": "searching", "TodoWrite": "planning"}

# ------------------------------------------------------------------ state ---
TASK_RE = re.compile(r"^===\s*(?:YOUR TASK|TASK)\s*[—:-]*\s*(.*?)\s*===\s*$", re.M)

def brief_title(path):
    if not path: return ""
    try: txt = Path(path).read_text("utf-8", "replace")
    except Exception: return ""
    m = TASK_RE.search(txt)
    if m and m.group(1): return m.group(1)
    for ln in (l.strip() for l in txt.splitlines()):
        if len(ln) > 40 and not ln.startswith(("=", "-", "#", "NEVER", "Do not")):
            return ln[:120]
    return ""

def adopt(pid, rid, args):
    reg = REG / f"{rid}.json"
    if reg.exists(): return
    brief, title = Path(f"/tmp/{rid}.brief"), ""
    if brief.exists():
        try:
            txt = brief.read_text("utf-8", "replace")
            m = TASK_RE.search(txt)
            title = m.group(1) if m and m.group(1) else ""
            if not title:
                for ln in (l.strip() for l in txt.splitlines()):
                    if len(ln) > 40 and not ln.startswith(("=", "-", "#", "NEVER", "Do not")):
                        title = ln[:120]; break
        except Exception: pass
    cwd = ""
    try:
        lo = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                            capture_output=True, text=True, timeout=10).stdout
        for l in lo.splitlines():
            if l.startswith("n"): cwd = l[1:]
    except Exception: pass
    branch = ""
    if cwd:
        r = subprocess.run(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip() != "HEAD": branch = r.stdout.strip()
    mo, ef = re.search(r"--model (\S+)", args), re.search(r"--effort (\S+)", args)
    try:
        reg.write_text(json.dumps({
            "id": rid, "title": title or f"(no task marker in {rid}.brief)",
            "worktree": cwd, "wt_name": Path(cwd).name if cwd else "",
            "branch": branch, "model": mo.group(1) if mo else "",
            "effort": ef.group(1) if ef else "", "pid": pid,
            "started": brief.stat().st_mtime if brief.exists() else time.time(),
            "brief": str(brief), "adopted": True}, indent=2))
    except Exception: pass

def summary_for(rid):
    """The SUMMARY: line an agent ends its report with. Read from the small
    report file rather than re-parsing a multi-megabyte transcript."""
    for cand in (REG / f"{rid}.report", Path(f"/tmp/{rid}.log")):
        if not cand.exists() or not cand.stat().st_size: continue
        try: txt = cand.read_text("utf-8", "replace")
        except Exception: continue
        for line in reversed(txt.splitlines()):
            t = line.strip().lstrip("*# ").strip()
            if t.upper().startswith("SUMMARY:"):
                return " ".join(t.split(":", 1)[1].split())
    return None

_GIT_TTL = 8.0
_gitcache = {}

def _cached(key, ttl, fn):
    """git status costs ~36ms and several runs share one worktree, so without
    this the refresh cost scales with runs rather than with worktrees."""
    now = time.time()
    hit = _gitcache.get(key)
    if hit and now - hit[0] < ttl:
        return hit[1]
    val = fn()
    if len(_gitcache) > 128: _gitcache.clear()
    _gitcache[key] = (now, val)
    return val

def wt_files(worktree, limit=12):
    """Which files the agent has actually touched, newest first. A young run has
    almost no events, so this is often the only concrete thing to show."""
    return _cached(("files", worktree), 5.0, lambda: _wt_files(worktree, limit))

def _wt_files(worktree, limit=12):
    if not worktree or not Path(worktree).is_dir(): return []
    try:
        r = subprocess.run(["git", "-C", worktree, "status", "--porcelain"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode != 0: return []
        out = []
        for l in r.stdout.splitlines():
            if not l.strip(): continue
            code, name = l[:2].strip() or "?", l[3:].strip().strip('"')
            try: mt = (Path(worktree) / name).stat().st_mtime
            except OSError: mt = 0
            out.append((mt, code, name))
        out.sort(reverse=True)
        return out[:limit]
    except Exception:
        return []

def brief_task(path, lines=10):
    """The task section of the brief, so the panel says what the run is for."""
    if not path: return []
    p = Path(path)
    if not p.exists(): return []
    try: txt = p.read_text("utf-8", "replace")
    except Exception: return []
    out, started = [], False
    for ln in txt.splitlines():
        if ln.strip().startswith("===") and ("TASK" in ln.upper()):
            started = True; continue
        if started:
            if ln.strip().startswith("==="): break
            if ln.strip(): out.append(ln.rstrip())
        if len(out) >= lines: break
    if not out:
        out = [l.rstrip() for l in txt.splitlines() if l.strip()][:lines]
    return out[:lines]

def wt_dirty(worktree):
    """int = uncommitted files (minus AGENT_IGNORE matches), "gone" = worktree
    vanished, None = not a repo. Gone must never look the same as clean."""
    return _cached(("dirty", worktree), _GIT_TTL, lambda: _wt_dirty(worktree))

def _wt_dirty(worktree):
    if not worktree: return None
    if not Path(worktree).is_dir(): return "gone"
    try:
        r = subprocess.run(["git", "-C", worktree, "status", "--porcelain"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode != 0: return None
        files = [l[3:].strip().strip('"') for l in r.stdout.splitlines() if l.strip()]
        ig = os.environ.get("AGENT_IGNORE") or None
        if ig: files = [f for f in files if ig not in f]
        return len(files)
    except Exception:
        return "gone"

FD_HINT = ("looks like the file-descriptor limit: claude dies instantly with "
           "this message when the soft limit is 256. Launch with "
           "`ulimit -n 65536` before it.")

def dead_runs(known, max_age=86400):
    """A run that dies in its first second leaves a brief and a tiny log and no
    process, so nothing else here would ever mention it. Silence is the worst
    possible report for a failed launch, so surface it."""
    out, now = [], time.time()
    for brief in Path("/tmp").glob("*.brief"):
        rid = brief.stem
        if rid in known: continue
        try:
            if now - brief.stat().st_mtime > max_age: continue
        except OSError:
            continue
        log = Path(f"/tmp/{rid}.log")
        if not log.exists(): continue
        try:
            if log.stat().st_size > 2000: continue      # a real report, not a crash
            txt = log.read_text("utf-8", "replace").strip()
        except OSError:
            continue
        if not txt: continue
        # A crash is claude's own `error: ...` on the first line. Matching any
        # log containing the word "error" flagged successful short reports.
        first = next((l for l in txt.splitlines() if l.strip()), "")
        crashed = (re.match(r"^\s*(error|fatal)\b", first, re.I)
                   or (len(txt) < 200 and "error" in txt.lower()))
        if not crashed: continue
        out.append({
            "id": rid, "title": "", "worktree": "", "wt_name": "", "branch": "",
            "model": "", "effort": "", "pid": None,
            "started": brief.stat().st_mtime, "brief": str(brief),
            "failed": first.strip()[:160],
            "hint": FD_HINT if "unknown error" in txt.lower() else "",
        })
    return out

def collect():
    ps = ps_snapshot()
    known = {f.stem for f in REG.glob("*.json") if f.name != "calibration.json"}
    # Adoption scans every claude -p on the box, so it will pull unrelated runs
    # into whatever registry is active. Opt out when you want an isolated view.
    if not os.environ.get("AGENTRUN_NO_ADOPT"):
        for pid, rid, args in strays(ps, known):
            if rid: adopt(pid, rid, args)
    runs = []
    for f in sorted(REG.glob("*.json")):
        if f.name == "calibration.json": continue
        try: r = json.loads(f.read_text())
        except Exception: continue
        r["running"] = alive(r.get("pid"), r["id"], ps)
        r["tpath"]   = transcript_for(r.get("worktree"), r.get("started"), r["id"])
        # our own stream is named for the run, not the session; find the id inside
        r["sid"]     = (r["tpath"].stem if r["tpath"] and r["tpath"].parent == PROJ.joinpath(r["tpath"].parent.name)
                        else None)
        if r["tpath"] and r["tpath"].parent == REG:
            r["sid"] = session_id_in(r["tpath"])
        elif r["tpath"]:
            r["sid"] = r["tpath"].stem
        r["dirty"]   = wt_dirty(r.get("worktree"))
        if r.get("fifo") and not Path(r["fifo"]).exists(): r["fifo"] = None
        runs.append(r)
    for d in dead_runs({r["id"] for r in runs}):
        d["running"], d["tpath"], d["sid"] = False, None, None
        d["dirty"], d["shared_with"] = None, None
        d["title"] = d["title"] or brief_title(d["brief"]) or "(launch failed)"
        runs.append(d)
    runs.sort(key=lambda r: (0 if r["running"] else 1, -r.get("started", 0)))
    # Several runs often reuse one worktree. Its uncommitted files belong to
    # whichever touched it last; repeating them under three runs reads as 30.
    claimed = {}
    for r in runs:
        wt = r.get("worktree")
        r["shared_with"] = None
        if wt and isinstance(r["dirty"], int) and r["dirty"]:
            if wt in claimed:
                r["shared_with"] = claimed[wt]
                r["dirty"] = 0
            else:
                claimed[wt] = r["id"]
    return runs

def calibration():
    p = REG / "calibration.json"
    try: return json.loads(p.read_text())
    except Exception: return None

# ----------------------------------------------------------------- screen ---
class Screen:
    def __init__(self):
        self.rows, self.cols = 24, 80
        self._prev, self._dirty = None, True
        self.measure()
    def measure(self):
        try:
            sz = os.get_terminal_size()
            if (sz.lines, sz.columns) != (self.rows, self.cols):
                self._dirty = True          # a resize invalidates the whole frame
            self.rows, self.cols = sz.lines, sz.columns
        except OSError:
            pass
    def enter(self):
        self._prev, self._dirty = None, True
        sys.stdout.write(f"{E}?1049h{E}?25l"); sys.stdout.flush()
    def leave(self):
        sys.stdout.write(f"{E}?25h{E}?1049l"); sys.stdout.flush()
    def paint(self, lines):
        """Write only the rows that changed. Repainting the whole screen on every
        keypress is what made scrolling feel heavy over ssh."""
        self.measure()
        lines = list(lines[: self.rows])
        if self._prev is None or len(self._prev) != len(lines) or self._dirty:
            body = "\r\n".join(l + f"{E}K" for l in lines)
            sys.stdout.write(f"{E}H" + body + f"{E}J")
            self._dirty = False
        else:
            out = []
            for i, (old, new) in enumerate(zip(self._prev, lines)):
                if old != new:
                    out.append(f"{E}{i + 1};1H{new}{E}K")
            if not out:
                return
            sys.stdout.write("".join(out))
        self._prev = lines
        sys.stdout.flush()

def wrap(text, width):
    out, cur = [], ""
    for w in str(text).split():
        if len(cur) + len(w) + 1 > width:
            out.append(cur); cur = w
        else:
            cur = f"{cur} {w}".strip()
    if cur: out.append(cur)
    return out or [""]

def read_key(timeout):
    """Return a key name, or None on timeout.

    Reads through os.read on the raw fd rather than sys.stdin. Python buffers
    stdin internally, so after reading the ESC of an arrow sequence the rest sat
    in that buffer while select reported the fd empty, and every arrow key came
    through as three separate keypresses.
    """
    fd = sys.stdin.fileno()
    if not select.select([fd], [], [], timeout)[0]:
        return None
    try: ch = os.read(fd, 1)
    except OSError: return None
    if not ch: return None
    if ch != b"\x1b":
        return {b"\r": "enter", b"\n": "enter",
                b"\x7f": "back", b"\x03": "q"}.get(ch, ch.decode("utf-8", "replace"))
    # escape: an arrow sends ESC [ A..D, a bare esc sends nothing more
    if not select.select([fd], [], [], 0.06)[0]:
        return "esc"
    try: rest = os.read(fd, 8)
    except OSError: return "esc"
    if rest[:1] != b"[":
        return "esc"
    return {b"A": "up", b"B": "down", b"C": "right", b"D": "left"}.get(rest[1:2], "esc")

def prompt(scr, label):
    """Inline single-line editor, in raw mode.

    The old version dropped to cooked mode and used readline, which meant esc did
    nothing and ctrl-c killed the whole interface instead of cancelling the edit.
    Returns None when cancelled, so an empty submit and a cancel stay distinct.
    """
    fd = sys.stdin.fileno()
    buf, cur = "", 0
    hint = dim("   esc cancel · ↵ send")
    while True:
        row = scr.rows
        shown = buf
        room = max(10, scr.cols - visible_len(label) - visible_len(hint) - 2)
        off = 0
        if len(shown) > room:                       # keep the caret in view
            off = max(0, cur - room + 1)
            shown = shown[off:off + room]
        sys.stdout.write(f"{E}{row};1H{E}K" + cyan(label) + shown + hint)
        sys.stdout.write(f"{E}{row};{visible_len(label) + (cur - off) + 1}H{E}?25h")
        sys.stdout.flush()
        try:
            ch = os.read(fd, 1)
        except OSError:
            ch = b""
        if not ch:
            buf = None; break
        if ch in (b"\r", b"\n"):
            break
        if ch == b"\x03":                            # ctrl-c cancels the edit only
            buf = None; break
        if ch == b"\x1b":
            if not select.select([fd], [], [], 0.06)[0]:
                buf = None; break                   # bare esc cancels
            seq = os.read(fd, 8)
            if seq[:1] == b"[":
                c = seq[1:2]
                if   c == b"D": cur = max(0, cur - 1)
                elif c == b"C": cur = min(len(buf), cur + 1)
                elif c == b"H": cur = 0
                elif c == b"F": cur = len(buf)
            continue
        if ch in (b"\x7f", b"\x08"):                 # backspace
            if cur: buf, cur = buf[:cur - 1] + buf[cur:], cur - 1
            continue
        if ch == b"\x15":                            # ctrl-u clears the line
            buf, cur = "", 0
            continue
        if ch == b"\x17":                            # ctrl-w deletes a word
            left = buf[:cur].rstrip()
            cut = left.rfind(" ") + 1
            buf, cur = buf[:cut] + buf[cur:], cut
            continue
        if ch == b"\x01": cur = 0; continue          # ctrl-a
        if ch == b"\x05": cur = len(buf); continue    # ctrl-e
        try: s = ch.decode("utf-8")
        except UnicodeDecodeError:
            extra = os.read(fd, 3)
            try: s = (ch + extra).decode("utf-8", "ignore")
            except Exception: continue
        if s and s.isprintable():
            buf, cur = buf[:cur] + s + buf[cur:], cur + len(s)
    sys.stdout.write(f"{E}?25l"); sys.stdout.flush()
    scr._dirty = True
    return buf

def send_live(run, text):
    """Queue a message straight into a running agent's stdin. It arrives at the
    agent's next turn boundary — this is not an interrupt, and cannot stop work
    already in flight."""
    fifo = run.get("fifo")
    if not (fifo and Path(fifo).exists()): return None
    # Framed as an aside. Without this an agent tends to treat an incoming
    # message as a new instruction and abandon what it was doing; one under test
    # stopped mid-task to argue about a note instead of finishing.
    framed = ("[Note from the orchestrator, sent while you work. Read it, and "
              "carry on with your current task unless it genuinely changes what "
              "you should do. If it does not apply, ignore it and keep going.]\n\n"
              + text)
    try:
        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps({"type": "user", "message": {"role": "user",
                    "content": [{"type": "text", "text": framed}]}}) + "\n")
        return ("delivered as a side note. The agent picks it up at its next "
                "turn and keeps working; it is not an interrupt.")
    except Exception as e:
        return f"(could not reach the live agent: {e})"

def observe(run, question):
    """Answer about a run without resuming its session.

    Resuming replays the agent's whole conversation. On a 1.1 MB transcript at
    opus/high, answering "hi" took over nine minutes. This instead hands a small
    read-only agent the same evidence the dashboard shows and asks it there:
    seconds instead of minutes, no tools, and the working agent is untouched.
    """
    ev, mtime = read_transcript(run.get("tpath"), 300_000)
    lines = []
    for kind, val, _ in ev[-90:]:
        if kind == "say":
            lines.append("said: " + " ".join(str(val).split())[:400])
        else:
            lines.append("did: " + (val[2] if len(val) > 2 else val[1]))
    files = wt_files(run.get("worktree"), 40)
    now = time.time()
    ctx = "\n".join([
        "You are looking at a log of a coding agent that is working right now.",
        "Answer the question from this evidence only. Be brief and concrete.",
        "Do not use any tools. If the log does not say, say so plainly.",
        "",
        "Task it was given: " + str(run.get("title", "(unknown)")),
        "State: " + ("running" if run.get("running") else "finished")
        + ", started " + hms(now - run.get("started", now)) + " ago"
        + ", last activity " + (hms(now - mtime) if mtime else "unknown") + " ago",
        "Working directory: " + str(run.get("worktree", "(none)")),
        "",
        "Files it has changed so far:",
        *([f"  {c} {n}" for _, c, n in files] or ["  (none yet)"]),
        "",
        "Most recent activity, oldest first:",
        *([f"  {l}" for l in lines] or ["  (nothing recorded yet)"]),
        "",
        "Question: " + question,
    ])
    cmd = ["claude", "-p", ctx, "--model", "sonnet", "--effort", "low",
           "--disallowedTools", "Bash", "Edit", "Write", "Read", "Task",
           "--permission-mode", "bypassPermissions"]
    try:
        # cwd is /tmp, not the worktree: nothing it could damage even if it tried
        r = subprocess.run(cmd, cwd="/tmp", input="", capture_output=True,
                           text=True, timeout=240)
        return (r.stdout or r.stderr or "").strip() or "(no answer)"
    except subprocess.TimeoutExpired:
        return "(timed out after 4 minutes)"
    except Exception as e:
        return "(failed: %s)" % e

def send_message(run, text):
    """Resume the agent's own session and ask it something. Fork while it is
    still running, so two processes never share one session."""
    if not run.get("sid"):
        return ("No session transcript found for this run yet, so there is "
                "nothing to resume. Claude writes one shortly after an agent "
                "starts; try again in a few seconds.")
    cmd = ["claude", "--resume", run["sid"], "-p", text,
           "--permission-mode", "bypassPermissions"]
    if run["running"]: cmd.insert(3, "--fork-session")
    try:
        r = subprocess.run(cmd, cwd=run.get("worktree") or None, input="",
                           capture_output=True, text=True, timeout=900)
        return (r.stdout or r.stderr or "(no reply)").strip()
    except subprocess.TimeoutExpired:
        return "(timed out after 15 minutes)"
    except Exception as e:
        return f"(failed: {e})"

# ------------------------------------------------------------------ views ---
def is_idle(r):
    """Finished, nothing uncommitted, nothing to explain. Failed launches are
    never idle: a run that died silently is the whole point of this view."""
    if r.get("failed"): return False
    return (not r["running"] and not r.get("shared_with")
            and (r["dirty"] in (0, None) or r["dirty"] == "gone"))

def visible_runs(runs, show_all):
    """Rows actually on screen. The selection indexes these, not every run:
    with finished runs hidden, indexing the full list opens the wrong one."""
    if show_all: return list(runs)
    return [r for r in runs if not is_idle(r)]

def overview(runs, sel, show_all, cal, W, H=0):
    live = sum(1 for r in runs if r["running"])
    rev  = sum(1 for r in runs if not r["running"]
               and isinstance(r["dirty"], int) and r["dirty"])
    gone = sum(1 for r in runs if r["running"] and r["dirty"] == "gone")
    failed = sum(1 for r in runs if r.get("failed"))
    head = f"AGENTS · {live} running · {rev} needs review"
    if failed: head += f" · {failed} FAILED TO START"
    if gone: head += f" · {gone} WORKTREE GONE MID-RUN"
    L = ["", " " + bold(head), " " + dim("─" * min(W - 2, 74))]
    now, hidden, vi = time.time(), 0, -1
    for r in runs:
        idle = is_idle(r)
        if idle and not show_all:
            hidden += 1; continue
        ev, mtime = (read_transcript(r["tpath"], 60_000) if r["running"]
                     else ([], r["tpath"].stat().st_mtime if r["tpath"] else None))
        stalled = r["running"] and mtime and (now - mtime) > STALL
        if r.get("failed"): mark, tone = "✗", red
        elif stalled:      mark, tone = "⚠", yellow
        elif r["running"]: mark, tone = "●", green
        elif isinstance(r["dirty"], int) and r["dirty"]: mark, tone = "✓", cyan
        else:              mark, tone = "✓", dim
        meta  = "/".join(v for v in (r.get("model"), r.get("effort")) if v)
        where = r.get("wt_name") or "?"
        if r.get("branch") and r["branch"] != r.get("wt_name"):
            where += " → " + r["branch"]
        vi += 1                       # index among visible rows only
        picked = (vi == sel)
        # A selected row is drawn as plain text then inverted whole. Colour codes
        # inside it reset the inversion partway, which is why it looked unselected.
        if picked:
            plain = (f" {mark} {r['id']:<12}"
                     f"{hms(now - r.get('started', now)):>6} · {meta:<12} {where}")
            L.append(inv(plain[:W].ljust(min(W, 78))))
        else:
            L.append(f" {tone(mark)} {bold(r['id']):<12}"
                     f"{hms(now - r.get('started', now)):>6} · {meta:<12} {dim(where)}")
        # a gutter marks which block belongs to the selected row
        g = cyan("\u2502") + " " if picked else "  "
        for ln in wrap(r.get("title", ""), W - 8)[:2]:
            L.append(g + " " + ln)
        if r["running"]:
            say  = next((v for k, v, _ in reversed(ev) if k == "say"), None)
            if say: say = " ".join(str(say).split())
            tool = next((v for k, v, _ in reversed(ev) if k == "tool"), None)
            if tool:
                ph  = PHASE.get(tool[0], tool[0])
                age = hms(now - mtime) if mtime else "?"
                room = max(20, W - 22)
                what = tool[2] if len(tool) > 2 else tool[1]
                left = f"   ▸ {what}"
                if len(left) > room: left = left[: room - 1] + "…"
                L.append(g + f"{left:<{room}}  " + dim(f"{age} ago"))
            if say:
                for ln in wrap("“" + say[:200] + "”", W - 12)[:2]:
                    L.append(g + "    " + dim(ln))
            if stalled:
                L.append(g + "  " + yellow(f"no events for {hms(now - mtime)}, may be hung"))
            elif cal and cal.get("median_min") and (now - r.get("started", now)) > 120:
                L.append(g + "  " + dim(f"typical {cal['p25_min']}–{cal['p75_min']}m "
                                          f"across {cal['n']} past runs"))
        elif r.get("failed"):
            L.append(g + "  " + red("died at launch: " + r["failed"]))
            if r.get("hint"):
                for ln in wrap(r["hint"], W - 8)[:2]:
                    L.append(g + "  " + dim(ln))
        else:
            if r["dirty"] == "gone":
                L.append(g + "  " + dim("worktree removed, cannot verify what was harvested"))
            elif r.get("shared_with"):
                L.append(g + "  " + dim(f"shares worktree with {r['shared_with']}, "
                                     f"which holds the uncommitted work"))
            elif isinstance(r["dirty"], int) and r["dirty"]:
                L.append(g + "  " + yellow(f"{r['dirty']} file"
                                        f"{'s' if r['dirty'] != 1 else ''} UNCOMMITTED"))
            sm = summary_for(r["id"])
            if sm:
                for j, ln in enumerate(wrap(sm, W - 14)[:3]):
                    L.append(g + "  " + (dim("SUMMARY: ") if j == 0 else "         ") + dim(ln))
        L.append("")
    if hidden and not show_all:
        L.append(" " + dim(f"{hidden} finished and harvested · a to show"))
    if H:
        while len(L) < H - 1: L.append("")
        L.append(dim("  ↑↓ move · ↵ open · m message · a all · q quit"))
    return L

def detail(run, ev, mtime, scroll, W, H, reply, full=False):
    now = time.time()
    state = green("running") if run["running"] else dim("finished")
    L = ["", " " + bold(run["id"]) + "  " + state
         + dim(f"   {hms(now - run.get('started', now))}"
               f"   {run.get('model','')}/{run.get('effort','')}"
               f"   {run.get('wt_name','')}")]
    for ln in wrap(run.get("title", ""), W - 3):
        L.append(" " + ln)
    tools = sum(1 for k, _, _ in ev if k == "tool")
    age   = hms(now - mtime) if mtime else "?"
    files = wt_files(run.get("worktree"))
    stats = f"{tools} tool calls · last activity {age} ago · {len(files)} files touched"
    if run.get("total_cost_usd"): stats += f" · ${run['total_cost_usd']:.2f}"
    L.append(" " + dim(stats))
    if run.get("worktree"): L.append(" " + dim(run["worktree"]))
    if run.get("sid"): L.append(" " + dim("session " + run["sid"]))
    if run["running"]:
        L.append(" " + (green("live channel open · m sends a side note, delivered "
                              "at its next turn")
                        if run.get("fifo") and Path(run["fifo"]).exists()
                        else dim("no live channel · m asks a forked copy, the running "
                                 "agent is not disturbed")))
    # The feed is the point of this screen, so the file list only gets the rows
    # it can spare. On a short terminal it collapses to a single line.
    if files:
        spare = H - len(L) - 12
        if spare >= 4:
            shown = files[:min(6, spare)]
            L.append(" " + cyan("changed so far") + dim("  (newest first)"))
            for _, code, name in shown:
                L.append("   " + dim(f"{code:<3}") + name[:W - 8])
            if len(files) > len(shown):
                L.append("   " + dim(f"and {len(files) - len(shown)} more"))
        else:
            L.append(" " + cyan("changed so far") +
                     dim(f"  {len(files)} files, newest {files[0][2]}"[:W - 20]))
    L.append(" " + dim("─" * min(W - 2, 74)))

    # Digest by default. An agent's final report is markdown, often hundreds of
    # lines, and dumping it raw makes the panel unreadable. `f` shows everything.
    feed, i, cap = [], 0, (9999 if full else 3)
    while i < len(ev):
        kind, val, _ = ev[i]
        if kind == "tool":
            human = val[2] if len(val) > 2 else val[1]
            n = 1
            while (i + n < len(ev) and ev[i + n][0] == "tool"
                   and (ev[i + n][1][2] if len(ev[i + n][1]) > 2 else "") == human):
                n += 1
            label = human + (f"  ×{n}" if n > 1 else "")
            feed.append("  " + dim(("· " + label)[: W - 4]))
            i += n
            continue
        shown, rest = digest(val, W - 6, cap)
        for ln in shown:
            feed.append("  " + ln)
        if rest:
            feed.append("  " + dim(f"  … {rest} more lines · f to expand"))
        feed.append("")
        i += 1
    # The conversation gets its own reserved block at the bottom instead of
    # replacing the screen. A long answer scrolls in place with the arrows.
    convo, reply_lines, reply_room = [], [], 0
    if reply:
        convo.append(" " + dim("\u2500" * min(W - 2, 74)))
        convo.append(" " + cyan("you \u203a ") + reply["q"][:W - 8])
        if reply.get("pending"):
            convo.append(" " + dim("agent \u2039 waiting, this can take a minute"))
        else:
            for para in strip_md(reply.get("a") or "(no reply)"):
                reply_lines += wrap(para, W - 10) if para.strip() else [""]
            reply_room = max(3, min(len(reply_lines), (H - len(L)) // 2))
            off = max(0, min(reply.get("scroll", 0), len(reply_lines) - reply_room))
            reply["scroll"] = off
            window = reply_lines[off:off + reply_room]
            for j, ln in enumerate(window):
                convo.append(" " + (cyan("agent \u2039 ") if j == 0 and off == 0
                                    else "        ") + ln)
            below = len(reply_lines) - off - reply_room
            if below > 0 or off > 0:
                bits = []
                if off > 0:    bits.append(f"{off} above")
                if below > 0:  bits.append(f"{below} below")
                convo.append(" " + dim("        \u2191\u2193 " + ", ".join(bits)))

    # A run a few seconds old has almost nothing in the feed. Show what it is
    # meant to do and what it has touched, rather than a screen of blank rows.
    if len(feed) < 6:
        task = brief_task(run.get("brief"))
        if task:
            feed = ["  " + cyan("── the task ──")] + \
                   ["  " + ln for t in task for ln in wrap(t, W - 4)] + [""] + feed
    room = H - len(L) - 2 - len(convo)
    start = max(0, len(feed) - room - scroll)
    L += feed[start:start + room] if room > 0 else []
    while len(L) < H - 1 - len(convo): L.append("")
    L += convo
    if reply and not reply.get("pending"):
        tail = "  ↑↓ scroll answer · esc close · ← back · m message · q quit"
    else:
        tail = ("  ↑↓ scroll · f " + ("digest" if full else "full text")
                + " · m ask · M resume · ← back · q quit")
    if scroll: tail += f"   (scrolled back {scroll})"
    L.append(dim(tail))
    return L

# ------------------------------------------------------------------- main ---
ORIGINAL = None

def main():
    global ORIGINAL
    # One plain snapshot, same data layer as the TUI so the two cannot drift.
    if "--once" in sys.argv:
        global _COLOR
        _COLOR = _COLOR and sys.stdout.isatty()
        runs = collect()
        for l in overview(runs, -1, "--all" in sys.argv, calibration(),
                          (os.get_terminal_size().columns if sys.stdout.isatty() else 96)):
            print(l)
        return
    if not sys.stdin.isatty():
        print("agentrun-tui needs a terminal (run it via `mini`)"); return
    fd = sys.stdin.fileno()
    ORIGINAL = termios.tcgetattr(fd)
    scr = Screen(); scr.enter(); tty.setraw(fd)
    sel, show_all, view, scroll, reply = 0, False, "list", 0, None
    full = False
    runs = collect()
    # Refresh off the draw loop. Collecting costs a burst of git calls, and doing
    # it inline froze the interface for a fraction of a second every few seconds.
    shared, lock, stop = {"runs": runs}, threading.Lock(), threading.Event()
    def refresher():
        while not stop.is_set():
            try:
                fresh = collect()
                with lock: shared["runs"] = fresh
            except Exception:
                pass
            # Idle boxes do not need polling at working speed.
            busy = any(r.get("running") for r in shared.get("runs", []))
            stop.wait(2.0 if busy else 8.0)
    threading.Thread(target=refresher, daemon=True).start()
    try:
        while True:
            with lock:
                runs = shared["runs"]
            sel = min(sel, max(0, len(visible_runs(runs, show_all)) - 1))
            if view == "list":
                scr.paint(overview(runs, sel, show_all, calibration(),
                                   scr.cols, scr.rows))
            else:
                run = vis[sel]
                ev, mtime = read_transcript(run["tpath"])
                scr.paint(detail(run, ev, mtime, scroll, scr.cols, scr.rows, reply, full))
            k = read_key(1.0)
            if k is None: continue
            # Drain whatever else is queued and apply it all before repainting.
            # Holding an arrow key produced one full repaint per keypress, so the
            # loop fell behind the input and the screen kept catching up.
            keys = [k]
            while len(keys) < 64:
                nk = read_key(0.0)
                if nk is None: break
                keys.append(nk)
            if "q" in keys: break
            for k in keys:
                vis = visible_runs(runs, show_all)
                if view == "list":
                    if   k == "down":  sel = min(sel + 1, max(0, len(vis) - 1))
                    elif k == "up":    sel = max(sel - 1, 0)
                    elif k == "a":     show_all = not show_all; sel = 0
                    elif k in ("enter", "right") and vis:
                        view, scroll, reply = "detail", 0, None
                else:
                    if   k in ("left", "back"): view, scroll, reply = "list", 0, None
                    elif k == "esc":
                        if reply: reply = None      # close the answer, keep the run open
                        else:     view, scroll = "list", 0
                    elif k == "up":
                        if reply and not reply.get("pending"):
                            reply["scroll"] = reply.get("scroll", 0) + 3
                        else: scroll += 3
                    elif k == "down":
                        if reply and not reply.get("pending"):
                            reply["scroll"] = max(0, reply.get("scroll", 0) - 3)
                        else: scroll = max(0, scroll - 3)
                    elif k == "f":
                        full = not full; scroll = 0
                    elif k in ("m", "M"):
                        run = vis[min(sel, len(vis) - 1)] if vis else None
                        live = bool(run and run["running"] and run.get("fifo"))
                        deep = (k == "M")
                        label = ("side note \u203a " if live
                                 else ("resume the session, slow \u203a " if deep
                                       else "ask about this run \u203a "))
                        txt = prompt(scr, label)
                        if txt and run:
                            reply = {"q": txt, "a": None, "pending": True}
                            # Answering can take a minute. Do it off the draw loop so
                            # the feed keeps updating instead of the screen freezing.
                            def _ask(box=reply, r=run, t=txt, was_live=live, deep=deep):
                                out = send_live(r, t) if was_live else None
                                if out is None:
                                    out = send_message(r, t) if deep else observe(r, t)
                                box["a"] = out
                                box["pending"] = False
                            threading.Thread(target=_ask, daemon=True).start()
                            scroll = 0
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        termios.tcsetattr(fd, termios.TCSADRAIN, ORIGINAL)
        scr.leave()

main()
